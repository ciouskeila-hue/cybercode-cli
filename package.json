{
  "name": "cybercode-cli",
  "version": "1.4.16",
  "description": "Codex-dark web UI with a built-in self-evolving agent. Free GPT-5.5, Claude Opus 4.8, GLM-5.2 + image/video generation.",
  "type": "module",
  "main": "bin/cli.mjs",
  "bin": {
    "cybercode": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "python/",
    "skills/",
    "templates/",
    "scripts/",
    "docs/",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/cli.mjs",
    "webui": "node bin/cli.mjs webui",
    "update": "node bin/cli.mjs update",
    "doctor": "node bin/cli.mjs doctor",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "keywords": [
    "cli",
    "agent",
    "llm",
    "ai",
    "codex",
    "web-ui",
    "chatgpt",
    "coding-assistant",
    "self-evolving",
    "gpt5",
    "claude",
    "glm",
    "image-generation",
    "video-generation",
    "hyperframes"
  ],
  "author": "CyberCode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciouskeila-hue/cybercode-cli.git"
  },
  "homepage": "https://github.com/ciouskeila-hue/cybercode-cli",
  "bugs": {
    "url": "https://github.com/ciouskeila-hue/cybercode-cli/issues"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}